# Sao chép file này thành .env.local và điền tối đa bốn khóa Google AI Studio.
# .env.local đã được Git ignore, không đưa khóa thật lên GitHub.
# Thanh toán: để trống các thông tin chưa có; COD luôn khả dụng.
BANK_ID=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
BANK_QR_TEMPLATE=compact2
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# URL HTTPS công khai của backend để nhận IPN khi thử gateway.
BACKEND_PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:4200
# Mặc định giữ Gemini để tương thích với run-gemini.cmd.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite
# Giữ model cũ; chuyển API key khi cần dự phòng.
AI_FALLBACK_MODEL=
AI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY_1=PASTE_GEMINI_API_KEY_HERE
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# AI_API_KEY cũ vẫn được đọc nếu cả bốn ô trên đều trống.
# Để dùng OpenRouter, bỏ dấu # ở 4 dòng dưới và thay API key:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openrouter/free
# AI_API_KEY=PASTE_OPENROUTER_API_KEY_HERE
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=4096
# Sinh khóa JWT riêng trước khi chạy; không đưa khóa thật vào Git.
JWT_SECRET=
MAIL_OUTBOX_KEY=
